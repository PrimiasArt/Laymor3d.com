# ====================================================================
# 3D HUB V2 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or configure in Vercel Dashboard
# ====================================================================

# 1. NEON SERVERLESS POSTGRESQL (Scale-to-Zero Database)
# Lấy chuỗi kết nối từ https://console.neon.tech
DATABASE_URL="postgres://username:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Hoặc alias:
NEON_DATABASE_URL=

# 2. GITHUB SYNC CHO OBSIDIAN VAULT
# GitHub Personal Access Token (Fine-grained hoặc Classic với quyền Contents: Read and write)
GITHUB_VAULT_SYNC_TOKEN=
# Repository target (Mặc định: PrimiasArt/3dHubv2)
GITHUB_REPOSITORY=PrimiasArt/3dHubv2
GITHUB_VAULT_BRANCH=main

# 3. AI ENGINES & ANALYTICS
# Google Gemini API Key (Dùng cho Slicing AI, Fault Detection & Knowledge Search)
GEMINI_API_KEY=

# Fal.ai API Key (Dùng cho Tripo H3.1 Watertight & Trellis 2 3D Generation)
FAL_KEY=

# Meshy.ai API Key (Dùng cho Meshy 6 Master 4K Quad Mesh PBR)
MESHY_API_KEY=

# 4. OPTIONAL CRAWLER TOKENS
THINGIVERSE_TOKEN=
